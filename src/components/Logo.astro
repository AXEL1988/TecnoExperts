---
/* Logo oficial de Tecno Experts (public/img/logo.png, recortado de logo.jpeg con fondo transparente). */
const { height = 56 } = Astro.props;
---
<img class="logo" src="/img/logo.png" alt="Tecno Experts, especialistas de IT"
     height={height} width={Math.round(height * 1090 / 435)} decoding="async" />
