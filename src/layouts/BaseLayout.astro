---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { getNavResources, getServices, getSetting } from '../lib/db';

const {
  title = 'Tecno Experts',
  description = 'Infraestructura tecnológica crítica para empresas exigentes del Ecuador.'
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const services = getServices();
const resources = getNavResources();
const whatsapp = getSetting('whatsapp_url');
const email = getSetting('company_email');
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,600;0,700;1,700&family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="Tecno Experts, inicio"><Logo /></a>
        <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menú" aria-expanded="false">
          <Icon name="menu" size={22} />
        </button>
        <nav class="main-nav" id="main-nav" aria-label="Principal">
          <a href="/" class={isActive('/') ? 'active' : ''}>Inicio</a>
          <a href="/nosotros" class={isActive('/nosotros') ? 'active' : ''}>Nosotros</a>

          <div class="nav-item" data-dropdown>
            <button class={`nav-link ${isActive('/soluciones') ? 'active' : ''}`}
                    aria-expanded="false" aria-haspopup="true">
              Soluciones <Icon name="chevron-down" size={15} stroke={2} class="caret" />
            </button>
            <div class="nav-menu nav-menu-wide">
              {services.map((service) => (
                <a class="nav-menu-item" href="/soluciones">
                  <span class="icon-tile"><Icon name={service.icon_name ?? 'cube'} size={21} /></span>
                  <span>
                    <strong>{service.short_title ?? service.title}</strong>
                    <small>{service.benefit}</small>
                  </span>
                </a>
              ))}
              <a class="nav-menu-all" href="/soluciones">
                Ver todas las soluciones <Icon name="arrow-right" size={15} stroke={2} />
              </a>
            </div>
          </div>

          <a href="/casos" class={isActive('/casos') ? 'active' : ''}>Casos de Éxito</a>

          {resources.length > 0 && (
            <div class="nav-item" data-dropdown>
              <button class="nav-link" aria-expanded="false" aria-haspopup="true">
                Recursos <Icon name="chevron-down" size={15} stroke={2} class="caret" />
              </button>
              <div class="nav-menu">
                {resources.map((item) => (
                  <a class="nav-menu-item" href={item.url}>
                    <span class="icon-tile"><Icon name={item.icon_name} size={21} /></span>
                    <span>
                      <strong>{item.label}</strong>
                      {item.description && <small>{item.description}</small>}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <a href="/contacto" class={isActive('/contacto') ? 'active' : ''}>Contacto</a>
          <a class="btn btn-primary" href="/contacto">
            Diagnóstico Gratuito <Icon name="arrow-right" size={17} stroke={2} />
          </a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-about">
          <Logo />
          <p>Diseñamos, implementamos y sostenemos infraestructuras críticas que garantizan la continuidad operativa de tu negocio.</p>
          <div class="social">
            <a href="#" aria-label="LinkedIn"><Icon name="linkedin" size={19} /></a>
            <a href="#" aria-label="Facebook"><Icon name="facebook" size={19} /></a>
            <a href="#" aria-label="YouTube"><Icon name="youtube" size={19} /></a>
          </div>
        </div>
        <div class="footer-col">
          <h3>Servicios</h3>
          <a href="/soluciones">Virtualización VMware</a>
          <a href="/soluciones">Backup y Recuperación</a>
          <a href="/soluciones">Hardware Corporativo</a>
          <a href="/soluciones">DRaaS, DRP e ISO 27001</a>
        </div>
        <div class="footer-col">
          <h3>Empresa</h3>
          <a href="/nosotros">Nosotros</a>
          <a href="/casos">Casos de Éxito</a>
          <a href="/contacto">Contacto</a>
        </div>
        <div class="footer-col">
          <h3>Legal</h3>
          <a href="/contacto">Política de Privacidad</a>
          <a href="/contacto">Términos y Condiciones</a>
        </div>
        <div class="footer-help">
          <h3>¿Necesitas ayuda?</h3>
          <p>Nuestro equipo está listo para responder tus dudas.</p>
          <a class="btn btn-outline" href={whatsapp} target="_blank" rel="noreferrer">
            <Icon name="whatsapp" size={18} /> Hablar por WhatsApp
          </a>
        </div>
      </div>
      <div class="container footer-bottom">
        © {new Date().getFullYear()} Tecno Experts. Todos los derechos reservados. · {email}
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('#nav-toggle');
      const nav = document.querySelector('#main-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });

      const dropdowns = Array.from(document.querySelectorAll('[data-dropdown]'));
      const closeAll = (except) => dropdowns.forEach((item) => {
        if (item === except) return;
        item.classList.remove('open');
        item.querySelector('.nav-link')?.setAttribute('aria-expanded', 'false');
      });

      dropdowns.forEach((item) => {
        const trigger = item.querySelector('.nav-link');
        trigger?.addEventListener('click', (event) => {
          event.stopPropagation();
          const open = !item.classList.contains('open');
          closeAll(item);
          item.classList.toggle('open', open);
          trigger.setAttribute('aria-expanded', String(open));
        });
      });

      // Cerrar al hacer clic fuera o con Escape.
      document.addEventListener('click', () => closeAll());
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const open = document.querySelector('[data-dropdown].open');
        closeAll();
        open?.querySelector('.nav-link')?.focus();
      });
      document.querySelectorAll('.nav-menu').forEach((menu) =>
        menu.addEventListener('click', (event) => event.stopPropagation()));
    </script>
  </body>
</html>
